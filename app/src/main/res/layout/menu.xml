<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5FF">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Icono -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:src="@android:drawable/ic_menu_upload"
            app:tint="#6750A4"
            android:contentDescription="Gestión de archivos" />

        <!-- Título -->
        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Gestión de Archivos"
            android:textColor="#1C1B1F"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Gestión de Archivos" />

        <!-- Descripción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Sube y visualiza tus obras"
            android:textColor="#49454F"
            android:textSize="14sp" />

        <!-- Botón subir archivos -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/Bt_SubirArchivos"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Subir Archivos"
            android:textAllCaps="false"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_upload"
            style="@style/Widget.Material3.Button" />

        <!-- Botón visualizar archivos -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/Bt_VisualizarArchivos"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Visualización de Archivos"
            android:textAllCaps="false"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_gallery"
            style="@style/Widget.Material3.Button.OutlinedButton" />



        <!-- Fila de botones inferiores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Botón regresar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/Bt_regresar1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Regresar"
                android:textAllCaps="false"
                app:cornerRadius="16dp"
                style="@style/Widget.Material3.Button.TextButton" />

            <!-- Botón siguiente -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/Bt_Siguiente"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Siguiente"
                android:textAllCaps="false"
                app:cornerRadius="16dp"
                style="@style/Widget.Material3.Button.TonalButton" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

