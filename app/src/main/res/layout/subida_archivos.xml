<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5FF">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel Principal"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1C1B1F"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                tools:text="Panel Principal" />

            <!-- Grupo 1: Multimedia -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/Btcamara"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Abrir Cámara"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_camera"
                app:cornerRadius="16dp"
                style="@style/Widget.Material3.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/Btsubidaarchivospdf"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Archivos PDF"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_agenda"
                app:cornerRadius="16dp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/Btsubidaarchivosword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Archivos Word"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_edit"
                app:cornerRadius="16dp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/Bt_datosf"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Datos Firebase"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_share"
                app:cornerRadius="16dp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="#E7E0EC" />

            <!-- Grupo 2: Acciones de abajo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/Btregresar2"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Regresar"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/Bt_infomacion"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Información"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>